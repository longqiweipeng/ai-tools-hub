---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="个人中心 - AI 工具箱">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">个人中心</h1>

    <!-- 用户信息卡片 -->
    <div class="card bg-base-100 shadow-md mb-6">
      <div class="card-body" id="profile-card">
        <div class="flex items-center gap-4 mb-4">
          <div class="avatar placeholder">
            <div id="avatar" class="bg-primary text-neutral-content rounded-full w-16 h-16 flex items-center justify-center text-2xl font-bold"></div>
          </div>
          <div>
            <h2 id="display-name" class="text-xl font-semibold"></h2>
            <p id="user-email" class="text-sm opacity-60"></p>
            <p id="member-badge" class="mt-1"></p>
          </div>
        </div>
      </div>
    </div>

    <!-- 快捷入口 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <a href="/dashboard/favorites" class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body text-center">
          <div class="text-3xl mb-2">❤️</div>
          <h3 class="font-semibold">我的收藏</h3>
          <p class="text-xs opacity-60">查看收藏的 AI 工具</p>
        </div>
      </a>
      <a href="/membership" class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body text-center">
          <div class="text-3xl mb-2">⭐</div>
          <h3 class="font-semibold">会员服务</h3>
          <p class="text-xs opacity-60">升级会员解锁更多权益</p>
        </div>
      </a>
      <a href="/submit" class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body text-center">
          <div class="text-3xl mb-2">📤</div>
          <h3 class="font-semibold">提交工具</h3>
          <p class="text-xs opacity-60">推荐好的 AI 工具给我们</p>
        </div>
      </a>
    </div>

    <!-- 未登录提示 -->
    <div id="not-logged-in" class="card bg-base-100 shadow-md p-12 text-center hidden">
      <div class="text-4xl mb-4">🔒</div>
      <h3 class="text-lg font-semibold mb-2">请先登录</h3>
      <p class="text-sm opacity-60 mb-4">登录后即可查看个人中心</p>
      <a href="/login" class="btn btn-primary">去登录</a>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';

  async function loadDashboard() {
    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      document.getElementById('not-logged-in').classList.remove('hidden');
      document.getElementById('profile-card').classList.add('hidden');
      return;
    }

    document.getElementById('avatar').textContent = (user.email?.[0] || 'U').toUpperCase();
    document.getElementById('display-name').textContent = user.email?.split('@')[0] || '用户';
    document.getElementById('user-email').textContent = user.email;

    // 查询会员信息
    const { data: profile } = await supabase
      .from('profiles')
      .select('member_tier, member_expires_at')
      .eq('id', user.id)
      .single();

    const badge = document.getElementById('member-badge');
    if (profile?.member_tier && profile.member_tier !== 'free') {
      const expires = new Date(profile.member_expires_at).toLocaleDateString('zh-CN');
      badge.innerHTML = `<span class="badge badge-warning">${profile.member_tier === 'silver' ? '白银' : '黄金'}会员 · 有效期至 ${expires}</span>`;
    } else {
      badge.innerHTML = `<a href="/membership" class="badge badge-outline badge-sm">免费用户 - 升级会员 →</a>`;
    }
  }

  loadDashboard();
</script>
