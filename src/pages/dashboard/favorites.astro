---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="我的收藏 - AI 工具箱">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-4 mb-6">
      <a href="/dashboard" class="btn btn-ghost btn-sm">← 返回</a>
      <h1 class="text-2xl font-bold">我的收藏</h1>
    </div>

    <div id="favorites-list" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>

    <div id="empty-state" class="card bg-base-100 shadow-md p-12 text-center hidden">
      <div class="text-4xl mb-4">❤️</div>
      <h3 class="text-lg font-semibold mb-2">还没有收藏</h3>
      <p class="text-sm opacity-60 mb-4">浏览工具并点击收藏按钮添加到这里</p>
      <a href="/tools" class="btn btn-primary">浏览工具</a>
    </div>

    <div id="not-logged-in" class="card bg-base-100 shadow-md p-12 text-center hidden">
      <div class="text-4xl mb-4">🔒</div>
      <h3 class="text-lg font-semibold mb-2">请先登录</h3>
      <p class="text-sm opacity-60 mb-4">登录后查看收藏</p>
      <a href="/login" class="btn btn-primary">去登录</a>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import tools from '../../data/tools.json';

  async function loadFavorites() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) {
      document.getElementById('not-logged-in').classList.remove('hidden');
      return;
    }

    const { data: favorites } = await supabase
      .from('favorites')
      .select('tool_id, created_at')
      .eq('user_id', user.id);

    if (!favorites || favorites.length === 0) {
      document.getElementById('empty-state').classList.remove('hidden');
      return;
    }

    const list = document.getElementById('favorites-list');
    const toolIds = favorites.map(f => f.tool_id);

    toolIds.forEach((toolId, _) => {
      const html = `
        <a href="/tools/${tools[toolId]?.slug || toolId}" class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="card-body p-4">
            <h3 class="font-semibold">${tools[toolId]?.name || `工具 #${toolId}`}</h3>
            <p class="text-xs opacity-60 line-clamp-2">${tools[toolId]?.description || ''}</p>
          </div>
        </a>
      `;
      list.innerHTML += html;
    });
  }

  loadFavorites();
</script>
