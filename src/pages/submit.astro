---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../lib/config';
---

<BaseLayout title="提交工具 - AI 工具箱">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-2xl font-bold mb-2">提交 AI 工具</h1>
    <p class="opacity-60 mb-6">推荐好的 AI 工具给我们，审核通过后会在网站展示</p>

    <div class="card bg-base-100 shadow-md">
      <div class="card-body">
        <form id="submit-form" class="space-y-4">
          <div class="form-control">
            <label class="label"><span class="label-text">工具名称 *</span></label>
            <input type="text" id="name" class="input input-bordered" placeholder="工具名称" required />
          </div>

          <div class="form-control">
            <label class="label"><span class="label-text">工具简介 *</span></label>
            <textarea id="description" class="textarea textarea-bordered h-24" placeholder="简要描述这个工具的功能和用途" required></textarea>
          </div>

          <div class="form-control">
            <label class="label"><span class="label-text">官方网站 *</span></label>
            <input type="url" id="website" class="input input-bordered" placeholder="https://example.com" required />
          </div>

          <div class="form-control">
            <label class="label"><span class="label-text">分类 *</span></label>
            <select id="category" class="select select-bordered" required>
              <option value="">选择分类</option>
              {CATEGORIES.filter(c => c.id !== 'other').map(cat => (
                <option value={cat.id}>{cat.icon} {cat.name}</option>
              ))}
            </select>
          </div>

          <div id="error-message" class="text-error text-sm hidden"></div>
          <div id="success-message" class="text-success text-sm hidden"></div>

          <button type="submit" id="submit-btn" class="btn btn-primary w-full">提交</button>
        </form>

        <div id="login-prompt" class="text-center py-8 hidden">
          <p class="mb-4">请先登录后再提交工具</p>
          <a href="/login" class="btn btn-primary">去登录</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  async function init() {
    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      document.getElementById('submit-form').classList.add('hidden');
      document.getElementById('login-prompt').classList.remove('hidden');
      return;
    }

    document.getElementById('submit-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('submit-btn');
      const errorEl = document.getElementById('error-message');
      const successEl = document.getElementById('success-message');

      btn.disabled = true;
      btn.textContent = '提交中...';
      errorEl.classList.add('hidden');
      successEl.classList.add('hidden');

      const { error } = await supabase.from('tool_submissions').insert({
        name: document.getElementById('name').value,
        description: document.getElementById('description').value,
        website_url: document.getElementById('website').value,
        category: document.getElementById('category').value,
      });

      if (error) {
        errorEl.textContent = '提交失败：' + error.message;
        errorEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = '提交';
      } else {
        successEl.textContent = '提交成功！我们会在审核后展示该工具。';
        successEl.classList.remove('hidden');
        btn.textContent = '已提交';
        document.getElementById('submit-form').reset();
      }
    });
  }

  init();
</script>
