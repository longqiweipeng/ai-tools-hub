<BaseLayout title="教程文章 - AI 工具箱">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-2">教程文章</h1>
    <p class="opacity-60 mb-8">AI 工具使用教程、评测对比和行业资讯</p>

    <div class="space-y-4">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="card bg-base-100 shadow-sm hover:shadow-md transition-all duration-200 hover:-translate-y-0.5 block"
        >
          <div class="card-body p-6">
            <div class="flex items-start justify-between mb-2">
              <h2 class="card-title text-xl">{post.title}</h2>
              <time class="text-xs opacity-50 whitespace-nowrap ml-4">{post.date}</time>
            </div>
            <p class="text-sm opacity-70 line-clamp-2 mb-3">{post.description}</p>
            <div class="flex flex-wrap gap-1">
              {post.tags.map((tag) => (
                <span class="badge badge-ghost badge-sm">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
