---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../lib/config';
import tools from '../data/tools.json';

const featuredTools = tools.filter((t) => t.isFeatured).slice(0, 6);
const latestTools = tools.slice(0, 8);

const blogPosts = [
  { slug: 'ai-image-tools-2025', title: '2025 年最佳 AI 图像生成工具推荐' },
  { slug: 'ai-video-tools-2025', title: 'AI 视频生成工具全面评测' },
  { slug: 'ai-audio-tools-2025', title: 'AI 音频工具推荐' },
  { slug: 'chinese-ai-models-comparison', title: '国产 AI 大模型横向对比' },
  { slug: 'ai-productivity-tools', title: 'AI 办公提效工具推荐' },
];

const categoryNames = CATEGORIES.map(c => c.name).join('、');
---

<BaseLayout title="AI 工具箱 - 发现最好用的 AI 工具">
  <!-- Hero Section -->
  <section class="hero hero-gradient text-white rounded-2xl p-12 mb-12 shadow-lg">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">发现最好用的 AI 工具</h1>
        <p class="text-lg opacity-90 mb-6">
          精选 AI 工具评测、对比和使用教程，帮你找到最适合的 AI 工具
        </p>
        <div class="flex justify-center gap-3">
          <a href="/tools" class="btn btn-lg btn-accent">浏览工具</a>
          <a href="/categories/text" class="btn btn-lg btn-outline btn-light">分类查看</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 数据统计 -->
  <section class="stats shadow w-full mb-12 stats-vertical md:stats-horizontal">
    <div class="stat">
      <div class="stat-title">收录工具</div>
      <div class="stat-value text-primary">{tools.length}</div>
      <div class="stat-desc">持续更新中</div>
    </div>
    <div class="stat">
      <div class="stat-title">分类</div>
      <div class="stat-value text-secondary">{CATEGORIES.length}</div>
      <div class="stat-desc">{categoryNames}</div>
    </div>
    <div class="stat">
      <div class="stat-title">推荐文章</div>
      <div class="stat-value text-accent">{blogPosts.length}</div>
      <div class="stat-desc">AI 工具评测教程</div>
    </div>
    <div class="stat">
      <div class="stat-title">推荐工具</div>
      <div class="stat-value text-info">{tools.filter(t => t.isFeatured).length}</div>
      <div class="stat-desc">编辑精选</div>
    </div>
  </section>

  <!-- 分类导航 -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6">按分类浏览</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {CATEGORIES.filter(c => c.id !== 'other').map((cat) => (
        <a
          href={`/categories/${cat.id}`}
          class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow p-4"
        >
          <div class="text-3xl mb-2">{cat.icon}</div>
          <h3 class="font-semibold">{cat.name}</h3>
          <p class="text-xs opacity-60 mt-1">{cat.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- 推荐工具 -->
  {featuredTools.length > 0 && (
    <section class="mb-12">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold">推荐工具</h2>
        <a href="/tools" class="link link-primary">查看全部 →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredTools.map((tool) => (
          <a href={`/tools/${tool.slug}`} class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow">
            <div class="card-body">
              <div class="flex justify-between items-start">
                <h3 class="card-title">{tool.name}</h3>
                {tool.isPremium && <span class="badge badge-warning text-xs">会员</span>}
              </div>
              <p class="text-sm opacity-70 line-clamp-2">{tool.description}</p>
              <div class="flex items-center gap-2 mt-2">
                <span class="badge badge-outline badge-sm">
                  {CATEGORIES.find(c => c.id === tool.category)?.name || tool.category}
                </span>
                <span class="text-xs opacity-50">{tool.priceInfo}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 最新工具 -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6">最新收录</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {latestTools.map((tool) => (
        <a href={`/tools/${tool.slug}`} class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="card-body p-4">
            <h3 class="font-semibold text-sm">{tool.name}</h3>
            <p class="text-xs opacity-60 line-clamp-2">{tool.description}</p>
            <span class="badge badge-ghost badge-xs mt-1">
              {CATEGORIES.find(c => c.id === tool.category)?.name || tool.category}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="mb-12">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold">最新教程</h2>
      <a href="/blog" class="link link-primary">查看全部 →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {blogPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="card-body p-4">
            <h3 class="font-semibold text-sm">{post.title}</h3>
            <span class="text-xs opacity-50 mt-1">阅读更多 →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
