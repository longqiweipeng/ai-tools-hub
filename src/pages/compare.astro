    {"name":"DALL-E 3","slug":"dalle-3","category":"image","description":"OpenAI 开发的图像生成模型，文字理解能力强","priceInfo":"付费","priceModel":"paid","rating":4.5,"features":["文生图","高精度文字理解","风格多样","ChatGPT 集成","安全过滤"]},
    {"name":"Leonardo AI","slug":"leonardo-ai","category":"image","description":"功能丰富的 AI 图像生成平台","priceInfo":"免费增值","priceModel":"freemium","rating":4.4,"features":["多模型库","精细控制","图像编辑","视频生成","训练自定义模型"]},
    {"name":"Pika","slug":"pika","category":"video","description":"AI 视频生成平台，支持文生视频和图生视频","priceInfo":"免费增值","priceModel":"freemium","rating":4.3,"features":["文生视频","图生视频","视频编辑","风格控制","免费额度"]},
    {"name":"Sora","slug":"sora","category":"video","description":"OpenAI 推出的 AI 视频生成模型","priceInfo":"付费","priceModel":"paid","rating":4.6,"features":["高清视频生成","长时长","物理模拟","多镜头","真实风格"]},
    {"name":"Windsurf","slug":"windsurf","category":"code","description":"AI 驱动的 IDE，提供智能代码补全和重构功能","priceInfo":"免费增值","priceModel":"freemium","rating":4.5,"features":["AI 代码补全","多语言","IDE 集成","团队协作","代码搜索"]},
    {"name":"ElevenLabs","slug":"elevenlabs","category":"audio","description":"AI 语音合成工具，音质自然逼真","priceInfo":"免费增值","priceModel":"freemium","rating":4.7,"features":["语音合成","声音克隆","多语言","语音转语音","有声书制作"]},
    {"name":"讯飞听见","slug":"xunfei-tingjian","category":"audio","description":"科大讯飞推出的语音转文字和翻译工具","priceInfo":"付费","priceModel":"paid","rating":4.3,"features":["语音转文字","多语种翻译","会议记录","字幕生成","方言识别"]},
    {"name":"WPS AI","slug":"wps-ai","category":"office","description":"金山办公推出的 AI 办公助手","priceInfo":"免费增值","priceModel":"freemium","rating":4.2,"features":["文档生成","PPT 设计","表格处理","PDF 分析","AI 写作"]},
    {"name":"Adobe Firefly","slug":"adobe-firefly","category":"design","description":"Adobe 推出的 AI 创意工具，商用安全性高","priceInfo":"付费","priceModel":"paid","rating":4.4,"features":["文生图","生成式填充","文字特效","矢量图生成","商用安全"]},
    {"name":"稿定设计","slug":"gaoding-design","category":"design","description":"中国本土在线设计平台，海量模板搭配 AI 功能","priceInfo":"免费增值","priceModel":"freemium","rating":4.1,"features":["海量模板","AI 抠图","智能排版","团队协作","多格式导出"]},
    {"name":"秘塔 AI","slug":"mita-ai","category":"text","description":"中国新兴的 AI 搜索引擎，无广告、结构化搜索结果","priceInfo":"免费","priceModel":"free","rating":4.3,"features":["AI 搜索","无广告","结构化结果","深度研究","大纲生成"]},
    {"name":"豆包","slug":"doubao","category":"text","description":"字节跳动推出的 AI 对话助手，集成在抖音生态中","priceInfo":"免费","priceModel":"free","rating":4.3,"features":["AI 对话","图像生成","抖音集成","语音交互","多端同步"]}
  ];

  var CATEGORIES = {
    text: '文本生成', image: '图像生成', video: '视频生成',
    code: '编程助手', audio: '音频处理', office: '办公提效', design: '设计创意'
  };

  function getPriceLabel(m) {
    var map = { free: '免费', freemium: '免费增值', paid: '付费', usage: '按量付费' };
    return map[m] || m;
  }

  function buildStars(rating) {
    var h = '';
    for (var i = 0; i < 5; i++) {
      h += '<span class="' + (i < Math.round(rating) ? 'text-warning' : 'opacity-20') + '">★</span>';
    }
    return h;
  }

  (function () {
    var params = new URLSearchParams(window.location.search);
    var slugs = params.get('tools');
    if (!slugs) {
      document.getElementById('compare-table').innerHTML =
        '<div class="text-center py-12"><p class="text-lg opacity-60">请先在工具目录中选择要对比的工具</p>' +
        '<a href="/tools" class="btn btn-primary mt-4">去选择</a></div>';
      return;
    }

    var selected = slugs.split(',').map(function (s) { return s.trim(); });
    var tools = [];
    for (var i = 0; i < selected.length; i++) {
      for (var j = 0; j < ALL_TOOLS.length; j++) {
        if (ALL_TOOLS[j].slug === selected[i]) {
          tools.push(ALL_TOOLS[j]);
          break;
        }
      }
    }

    if (tools.length < 2) {
      document.getElementById('compare-table').innerHTML =
        '<div class="text-center py-12"><p class="text-lg opacity-60">请至少选择 2 个工具进行对比</p>' +
        '<a href="/tools" class="btn btn-primary mt-4">去选择</a></div>';
      return;
    }

    var rows = [
      { label: '名称', key: 'name', type: 'name' },
      { label: '评分', key: 'rating', type: 'rating' },
      { label: '分类', key: 'category', type: 'category' },
      { label: '价格', key: 'priceModel', type: 'price' },
      { label: '描述', key: 'description', type: 'text' },
    ];

    // Feature rows
    var maxFeatures = 0;
    for (var t = 0; t < tools.length; t++) {
      if (tools[t].features && tools[t].features.length > maxFeatures) {
        maxFeatures = tools[t].features.length;
      }
    }

    var html = '<div class="card bg-base-100 shadow-md">';
    html += '<div class="overflow-x-auto"><table class="table table-zebra w-full">';
    html += '<thead><tr><th class="w-24">项目</th>';

    var toolNames = [];
    for (var t = 0; t < tools.length; t++) {
      toolNames.push(tools[t].name);
      html += '<th class="text-center">' + tools[t].name + '</th>';
    }
    html += '</tr></thead><tbody>';

    // Basic info rows
    for (var r = 0; r < rows.length; r++) {
      var row = rows[r];
      html += '<tr><td class="font-semibold">' + row.label + '</td>';
      for (var t = 0; t < tools.length; t++) {
        var val = tools[t][row.key];
        html += '<td class="text-center">';
        if (row.type === 'rating') {
          html += buildStars(val) + ' <span class="text-sm opacity-50">' + val + '</span>';
        } else if (row.type === 'price') {
          html += getPriceLabel(val);
        } else if (row.type === 'category') {
          html += CATEGORIES[val] || val;
        } else {
          html += val || '-';
        }
        html += '</td>';
      }
      html += '</tr>';
    }

    // Features
    html += '<tr><td class="font-semibold align-top">功能特点</td>';
    for (var t = 0; t < tools.length; t++) {
      html += '<td><ul class="text-left space-y-1">';
      var feats = tools[t].features || [];
      for (var f = 0; f < feats.length; f++) {
        html += '<li class="flex items-center gap-1 text-sm"><span class="text-success">&#10003;</span> ' + feats[f] + '</li>';
      }
      html += '</ul></td>';
    }
    html += '</tr>';

    html += '</tbody></table></div></div>';

    // Action buttons
    html += '<div class="flex flex-wrap gap-3 mt-6 justify-center">';
    for (var t = 0; t < tools.length; t++) {
      html += '<a href="/tools/' + tools[t].slug + '" class="btn btn-outline btn-sm">查看 ' + tools[t].name + '</a>';
    }
    html += '</div>';

    document.getElementById('compare-table').innerHTML = html;
  })();
</script>
