    {"name":"通义千问","slug":"tongyi-qianwen","category":"text","description":"阿里巴巴开发的 AI 大模型，支持文本生成、文档处理等多种功能","priceInfo":"免费","priceModel":"free","rating":4.5,"features":["文本生成","文档处理","多轮对话","插件生态","中文优化"]},
    {"name":"Runway","slug":"runway","category":"video","description":"AI 视频生成和编辑平台，支持文生视频、视频修复等功能","priceInfo":"免费增值","priceModel":"freemium","rating":4.5,"features":["文生视频","视频修复","背景移除","运动追踪","实时编辑"]},
    {"name":"Notion AI","slug":"notion-ai","category":"office","description":"集成 AI 能力的笔记和协作平台，支持智能写作和知识管理","priceInfo":"付费","priceModel":"paid","rating":4.4,"features":["智能写作","知识管理","团队协作","数据库","模板库"]},
