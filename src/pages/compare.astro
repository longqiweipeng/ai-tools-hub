    {"name":"Perplexity","slug":"perplexity","category":"text","description":"AI 搜索引擎，实时联网获取信息并提供带引用的回答","priceInfo":"免费增值","priceModel":"freemium","rating":4.5,"features":["实时搜索","引用来源","深度研究","文件分析","Pro 搜索"]},
