---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="提交审核 - AI 工具箱">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-4 mb-6">
      <a href="/admin" class="btn btn-ghost btn-sm">← 后台</a>
      <h1 class="text-2xl font-bold">工具提交审核</h1>
    </div>

    <div id="login-check">
      <div class="text-center py-12 opacity-60">验证登录状态...</div>
    </div>

    <div id="submissions-list" class="hidden"></div>
  </div>
</BaseLayout>

<script is:inline src="/admin-submissions.js"></script>
