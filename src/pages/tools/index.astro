---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { CATEGORIES } from '../../lib/config';
import tools from '../../data/tools.json';

const categories = CATEGORIES;
const allTools = tools.sort((a, b) => b.rating - a.rating);
---

<BaseLayout title="AI 工具目录 - 发现最好用的 AI 工具">
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2">AI 工具目录</h1>
    <p class="opacity-70">浏览精选 AI 工具，按分类筛选，找到最适合你的工具</p>
  </div>

  <!-- 分类筛选 -->
  <div class="flex flex-wrap gap-2 mb-8">
    <a href="/tools" class="btn btn-sm btn-primary">全部 ({allTools.length})</a>
    {categories.filter(c => c.id !== 'other').map((cat) => {
      const count = tools.filter(t => t.category === cat.id).length;
      return (
        <a href={`/categories/${cat.id}`} class="btn btn-sm btn-ghost">
          {cat.icon} {cat.name} ({count})
        </a>
      );
    })}
  </div>

  <!-- 搜索框 -->
  <div class="mb-8">
    <label class="input input-bordered flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input type="search" class="grow" placeholder="搜索 AI 工具..." id="search-input" />
    </label>
  </div>

  <!-- 对比工具栏 -->
  <div id="compare-bar" class="sticky bottom-4 z-40 hidden">
    <div class="card bg-base-100 shadow-xl border border-primary/20">
      <div class="card-body p-3 flex flex-row items-center justify-between">
        <span id="compare-count" class="text-sm font-semibold"></span>
        <div class="flex gap-2">
          <button id="clear-compare" class="btn btn-ghost btn-sm">清空</button>
          <a id="compare-btn" href="/compare" class="btn btn-primary btn-sm">开始对比</a>
        </div>
      </div>
    </div>
  </div>

  <!-- 工具网格 -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="tools-grid">
    {allTools.map((tool, index) => (
      <div class="relative" data-tool-slug={tool.slug}>
        <!-- 对比勾选框 -->
        <label class="absolute top-2 left-2 z-10 cursor-pointer" onclick="event.stopPropagation()">
          <input type="checkbox" class="compare-checkbox checkbox checkbox-sm checkbox-primary" data-slug={tool.slug} />
        </label>
        <ToolCard tool={tool} />
      </div>
    ))}
  </div>
</BaseLayout>

<script>
  // 搜索功能
  const searchInput = document.getElementById('search-input');
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase();
      const items = document.querySelectorAll('#tools-grid > div');
      items.forEach((item) => {
        const text = item.textContent?.toLowerCase() || '';
        item.style.display = text.includes(query) ? '' : 'none';
      });
    });
  }

  // 对比功能
  var compareBar = document.getElementById('compare-bar');
  var compareCount = document.getElementById('compare-count');
  var compareBtn = document.getElementById('compare-btn');
  var maxCompare = 4;

  function updateCompareBar() {
    var checked = document.querySelectorAll('.compare-checkbox:checked');
    var count = checked.length;
    if (count >= 2) {
      compareBar.classList.remove('hidden');
      compareCount.textContent = '已选择 ' + count + ' 个工具（最多 ' + maxCompare + ' 个）';
      var slugs = [];
      checked.forEach(function (cb) { slugs.push(cb.getAttribute('data-slug')); });
      compareBtn.href = '/compare?tools=' + slugs.join(',');
    } else {
      compareBar.classList.add('hidden');
    }
  }

  document.querySelectorAll('.compare-checkbox').forEach(function (cb) {
    cb.addEventListener('change', function () {
      var checked = document.querySelectorAll('.compare-checkbox:checked');
      if (checked.length > maxCompare) {
        this.checked = false;
        return;
      }
      updateCompareBar();
    });
  });

  document.getElementById('clear-compare')?.addEventListener('click', function () {
    document.querySelectorAll('.compare-checkbox:checked').forEach(function (cb) { cb.checked = false; });
    updateCompareBar();
  });
</script>
