---
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import tools from '../data/tools.json';

export interface Props {
  title: string;
  description?: string;
  pubDate?: string;
  tags?: string[];
  author?: string;
  readingTime?: string;
}

const { title, description, pubDate, tags, author, readingTime } = Astro.props;
const safeTitle = title || '';

// 查找文章内链提到的工具
const relatedTools = tools
  .filter(t => safeTitle.includes(t.name) || safeTitle.includes(t.category))
  .slice(0, 3);
---

<BaseLayout title={safeTitle} description={description}>
  <!-- 面包屑 -->
  <div class="max-w-5xl mx-auto mb-4">
    <div class="breadcrumbs text-sm">
      <ul>
        <li><a href="/">首页</a></li>
        <li><a href="/blog">教程</a></li>
        <li>{safeTitle}</li>
      </ul>
    </div>
  </div>

  <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- 左侧：文章内容 -->
    <div class="lg:col-span-3">
      <div class="card bg-base-100 shadow-md">
        <div class="card-body p-6 md:p-8">
          <!-- 文章头 -->
          <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">{safeTitle}</h1>

            <div class="flex flex-wrap items-center gap-3 text-sm opacity-60 mb-4">
              {pubDate && (
                <time class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  {pubDate}
                </time>
              )}
              {readingTime && (
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {readingTime}
                </span>
              )}
              {author && <span>✍️ {author}</span>}
            </div>

            {tags && tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="badge badge-primary badge-outline badge-sm">{tag}</span>
                ))}
              </div>
            )}
          </header>

          <!-- 文章内容 -->
          <article class="prose prose-lg max-w-none
            prose-headings:font-bold prose-headings:mt-8 prose-headings:mb-4
            prose-h2:text-2xl prose-h3:text-xl
            prose-a:text-primary prose-a:no-underline hover:prose-a:underline
            prose-img:rounded-xl prose-img:shadow-md
            prose-code:bg-base-200 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
            prose-pre:bg-base-300 prose-pre:text-base-content
            prose-table:border-collapse prose-td:border prose-td:border-base-300 prose-td:p-3
            prose-th:border prose-th:border-base-300 prose-th:p-3 prose-th:bg-base-200
            prose-blockquote:border-l-primary prose-blockquote:bg-base-200 prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:rounded-r
          ">
            <slot />
          </article>

          <!-- 底部 -->
          <div class="mt-8 pt-6 border-t border-base-300">
            <ShareButtons title={safeTitle} />
          </div>
        </div>
      </div>

      <!-- 返回 -->
      <div class="mt-6 flex justify-between">
        <a href="/blog" class="btn btn-ghost btn-sm gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          返回文章列表
        </a>
      </div>
    </div>

    <!-- 右侧边栏 -->
    <div class="lg:col-span-1 space-y-6">
      <!-- 工具栏 -->
      <div class="card bg-base-100 shadow-sm sticky top-20">
        <div class="card-body p-4">
          <h3 class="font-semibold text-sm mb-3">📂 文章信息</h3>

          {pubDate && (
            <div class="flex justify-between text-xs mb-2">
              <span class="opacity-50">发布日期</span>
              <span>{pubDate}</span>
            </div>
          )}
          {readingTime && (
            <div class="flex justify-between text-xs mb-2">
              <span class="opacity-50">阅读时间</span>
              <span>{readingTime}</span>
            </div>
          )}
          {tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-1 mt-2">
              {tags.map((tag) => (
                <span class="badge badge-ghost badge-xs">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- 相关工具 -->
      {relatedTools.length > 0 && (
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body p-4">
            <h3 class="font-semibold text-sm mb-3">🔧 相关工具</h3>
            <div class="space-y-2">
              {relatedTools.map((t) => (
                <a href={`/tools/${t.slug}`} class="flex items-center gap-2 p-2 rounded-lg hover:bg-base-200 transition-colors">
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium truncate">{t.name}</p>
                    <div class="rating rating-xs">
                      {[...Array(5)].map((_, i) => (
                        <span class={`mask mask-star-2 ${i < Math.round(t.rating) ? 'bg-warning' : 'bg-base-300'}`} />
                      ))}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      )}

      <!-- 会员推广 -->
      <div class="card bg-gradient-to-br from-primary to-secondary text-primary-content shadow-sm">
        <div class="card-body p-4">
          <h3 class="font-semibold text-sm">⭐ 会员专属</h3>
          <p class="text-xs opacity-80 mt-1">开通会员阅读全部文章、下载资源</p>
          <a href="/membership" class="btn btn-sm btn-accent mt-3">了解详情</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
