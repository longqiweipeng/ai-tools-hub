---
interface Props {
  title: string;
  url?: string;
}

const { title, url } = Astro.props;
const shareUrl = url || Astro.url.href;
const encodedUrl = encodeURIComponent(shareUrl);
const encodedTitle = encodeURIComponent(title);
---

<div class="flex items-center gap-2 mt-4">
  <span class="text-xs opacity-50">分享：</span>

  <!-- 微博 -->
  <a href={`https://service.weibo.com/share/share.php?title=${encodedTitle}&url=${encodedUrl}`}
     target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-xs btn-square" title="分享到微博">
    <svg class="h-4 w-4 text-red-500" viewBox="0 0 24 24" fill="currentColor"><path d="M20.194 14.197c0 3.248-4.145 7.065-10.59 7.065-5.156 0-9.604-2.36-9.604-5.993 0-1.69 1.053-3.422 2.618-4.69.59-.48.428-1.235.154-1.672-.283-.454-.945-1.048-1.585-.96-.94.13-2.801 1.476-3.602 2.476-.423.529-.865.998-.865 1.646 0 3.566 5.234 7.212 12.61 7.212 7.072 0 12.61-3.073 12.61-6.51 0-2.178-2.326-4.158-4.922-4.758-1.26-.292-2.214-.17-2.214-1.096 0-.493.386-.912 1.122-1.274 2.124-1.043 4.048-2.597 4.048-4.544 0-2.5-2.475-3.99-5.54-3.99-3.307 0-5.974 1.856-5.974 4.197 0 1.217.8 2.244 1.744 3.056.648.557.728 1.443.29 2.138-.442.703-1.304 1.02-2.08.8-1.72-.49-3.19-2.13-3.19-4.11 0-3.472 3.666-6.3 8.27-6.3 4.468 0 8.14 2.618 8.14 5.948 0 2.167-1.378 3.995-3.138 4.958-.81.443-1.264.942-1.264 1.593 0 .68.556 1.12 1.368 1.344 2.05.565 4.006 1.756 4.006 3.587z"/></svg>
  </a>

  <!-- Twitter/X -->
  <a href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
     target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-xs btn-square" title="分享到 X">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
  </a>

  <!-- 复制链接 -->
  <button id="copy-link-btn" class="btn btn-ghost btn-xs btn-square" title="复制链接">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
    </svg>
  </button>
</div>

<script>
  document.getElementById('copy-link-btn')?.addEventListener('click', function () {
    navigator.clipboard.writeText(window.location.href).then(function () {
      var orig = this.innerHTML;
      this.innerHTML = '<span class="text-success text-xs">已复制</span>';
      var self = this;
      setTimeout(function () { self.innerHTML = orig; }, 2000);
    }.bind(this));
  });
</script>
